     /// Mouse trace and frustum test against the current camera, then fill
     /// `view` for rendering. Reuses `view`'s allocations.
+    /// M0 scratch-only: absolute paths in exactly the extracted FileView order.
+    pub fn probe_materialize(&mut self, paths:&[String]) {
+        for path in paths {
+            if let Some(file)=self.tree.find_file(path) { self.tree.set_file_hidden(file,false); }
+        }
+    }
+
+    pub fn probe_runtime(&self) -> f32 { self.runtime }
+
+    pub fn probe_file_paths(&self) -> Vec<String> {
+        if self.settings.hide_files { return Vec::new(); }
+        let mut out = Vec::new();
+        let mut stack = vec![self.tree.root()];
+        while let Some(d) = stack.pop() {
+            let node = &self.tree.dirs[d];
+            if node.in_frustum {
+                for &f in &node.files {
+                    let file = &self.tree.files[f];
+                    if !file.is_hidden() { out.push(file.fullpath.clone()); }
+                }
+            }
+            for &child in node.children.iter().rev() { stack.push(child); }
+        }
+        out
+    }
+
