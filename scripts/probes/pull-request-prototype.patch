 impl FrameBuilder {
+    /// M0 scratch-only measurement of the same anchors and fonts used by draw_label.
+    pub fn probe_label_rects(view:&SceneView,settings:&Settings,glyphs:&mut dyn GlyphSource)->Vec<[f32;4]> {
+        let scale=if view.ui_scale>0.0 {view.ui_scale}else{1.0};
+        let fonts=Fonts::new(settings,scale,glyphs);
+        let project=|p:Vec2|view.camera.project(view.viewport,p.extend(0.0))/scale;
+        let mut out=Vec::new();
+        for label in &view.labels {
+            let hidden=match label.font {FontRole::DirName=>settings.hide_dirnames,FontRole::FileName=>settings.hide_filenames||settings.hide_files,FontRole::UserName=>settings.hide_usernames||settings.hide_users,_=>false};
+            if hidden||label.text.is_empty()||label.colour.w<=0.0 {continue;}
+            let font=fonts.get(label.font);let text=view.str(label.text);let width=font.width(glyphs,text);let height=font.max_height();
+            let pos=match label.anchor {
+                LabelAnchor::WorldTopLeft{pos}=>project(pos),
+                LabelAnchor::WorldCentredAbove{pos}=>{let p=project(pos);Vec2::new(p.x-width*0.5,p.y-height)},
+                LabelAnchor::Dir{dir}=>{let Some(d)=view.dirs.get(dir as usize) else{continue;};let Some(parent)=d.parent.and_then(|p|view.dirs.get(p as usize)) else{continue;};label_pos(project(parent.pos)*scale,project(d.pos)*scale,project(d.spos)*scale,settings.dir_name_position)/scale},
+            };
+            out.push([pos.x*scale-2.0,pos.y*scale-2.0,(pos.x+width)*scale+2.0,(pos.y+height)*scale+2.0]);
+        }
+        out
+    }
+
     pub fn new() -> Self {
         FrameBuilder::default()
     }
